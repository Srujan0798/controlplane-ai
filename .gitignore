# Round 1 shipped. Build pipeline, raw proposals, and generated assets are
# parked on disk under archive/ for reference but not tracked in git.
#   archive/tools/*.pptx  — the 19 MB official AIC template (needed to build, not to review)
#   archive/video/vo/*.wav — 28 MB of recorded voiceover; NOT regenerable, do not delete
archive/

# Large pitch binaries stay local; allowlisted submission artifacts are tracked.
submission/*
!submission/latency_bench.json
!submission/ControlPlane_Round2_Proposal.pdf
!submission/sbom-pip-freeze.txt

# graphify's index. Regenerated from docs/ in seconds by `graphify extract .
# --code-only`, and rebuilt automatically by the post-commit hook.
graphify-out/

# Local noise
__pycache__/
/__pycache__
.venv/
.ruff_cache/
*.py[cod]
.DS_Store
.claude/

# Isolated feature worktrees
.worktrees/
.superpowers/

*.egg-info/
.venv/

# Local SQLite audit store (CONTROLPLANE_DB default)
.data/
