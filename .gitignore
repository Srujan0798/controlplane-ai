# Generated by the build — reproducible from source, never committed.
# `python3 -m visuals.render && python3 build_video.py && python3 build_submission.py
#  && python3 build_official.py` regenerates all of it byte-identically.

posters/*.png
video/frames/
video/*.mp4
visuals/_html/
submission/

# Large binaries kept on disk but out of git.
#   archive/tools/*.pptx  — the 19 MB official AIC template (needed to build, not to review)
#   video/vo/*.wav        — 28 MB of recorded voiceover; NOT regenerable, do not delete
archive/tools/*.pptx
video/vo/*.wav

# Local noise
__pycache__/
/__pycache__
.ruff_cache/
*.py[cod]
.DS_Store
.claude/
