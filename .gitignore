.superpowers/
.DS_Store

# One-off agent wave / impeccable reports (local provenance only)
.wave*
.impeccable*

# NOTE: round2/_archive/ and docs/_archive/ are TRACKED on purpose.
# They are the stage-by-stage provenance of the proposal. Do not ignore them.

# Large Round 1 parked assets (if present on disk)
archive/

