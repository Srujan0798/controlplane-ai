#!/usr/bin/env python3
"""Build the ControlPlane.ai Round 1 deck on the official AIC template.

Keeps the mandated scaffolding (cover, team details, video, thank-you) and
replaces the sample content slides with the three frozen content slides.
Everything is drawn with native PowerPoint shapes so the file stays editable,
vector-crisp and far under the 20 MB cap. Arial throughout, per the template's
own instruction slide.
"""
from pptx import Presentation
from pptx.util import Inches as I, Pt
from pptx.dml.color import RGBColor as C
from pptx.enum.text import PP_ALIGN, MSO_ANCHOR
from pptx.enum.shapes import MSO_SHAPE
import copy

SRC = "AIC_Talent-Brand_PPT-Template (1).pptx"
OUT = "ControlPlane_ControlPlane-ai.pptx"

# ---- palette: template brand + two semantic colours only -------------------
PURPLE   = C(0x74, 0x00, 0xC0)   # accent1 - brand
DEEP     = C(0x45, 0x00, 0x73)   # dk2     - brand deep
BLUE     = C(0x22, 0x4B, 0xFF)   # accent5 - escalate
INK      = C(0x1A, 0x1A, 0x1A)
INK2     = C(0x55, 0x55, 0x55)
INK3     = C(0x80, 0x80, 0x80)
RULE     = C(0xC9, 0xC9, 0xC9)
FILL     = C(0xF2, 0xF2, 0xF2)
WHITE    = C(0xFF, 0xFF, 0xFF)
UNBOUND  = C(0xB3, 0x26, 0x1E)   # the one saturated colour on slide 2
UNB_BG   = C(0xF7, 0xE3, 0xE1)
ACL      = C(0xB2, 0x6A, 0x00)   # entitlement highlight
ACL_BG   = C(0xFA, 0xEE, 0xD8)
M_BLOCK  = C(0xF4, 0xDA, 0xD7); M_BLOCK_T = UNBOUND
M_ESC    = C(0xDD, 0xE3, 0xF7); M_ESC_T   = BLUE
M_EDIT   = C(0xF9, 0xEB, 0xD5); M_EDIT_T  = ACL
M_PASS   = C(0xED, 0xED, 0xED); M_PASS_T  = C(0x70, 0x70, 0x70)

F = "Arial"


# ---------------------------------------------------------------- helpers --
def txt(slide, x, y, w, h, text, size=12, bold=False, color=INK, align=PP_ALIGN.LEFT,
        anchor=MSO_ANCHOR.TOP, space_after=0, line=None, italic=False, font=F):
    tb = slide.shapes.add_textbox(I(x), I(y), I(w), I(h))
    tf = tb.text_frame
    tf.word_wrap = True
    tf.margin_left = tf.margin_right = tf.margin_top = tf.margin_bottom = 0
    tf.vertical_anchor = anchor
    lines = text.split("\n")
    for i, ln in enumerate(lines):
        p = tf.paragraphs[0] if i == 0 else tf.add_paragraph()
        p.alignment = align
        p.space_after = Pt(space_after)
        if line:
            p.line_spacing = line
        r = p.add_run(); r.text = ln
        r.font.size = Pt(size); r.font.bold = bold; r.font.italic = italic
        r.font.name = font; r.font.color.rgb = color
    return tb


def box(slide, x, y, w, h, fill=None, linec=RULE, lw=0.75, shape=MSO_SHAPE.RECTANGLE, dash=None):
    s = slide.shapes.add_shape(shape, I(x), I(y), I(w), I(h))
    if fill is None:
        s.fill.background()
    else:
        s.fill.solid(); s.fill.fore_color.rgb = fill
    if linec is None:
        s.line.fill.background()
    else:
        s.line.color.rgb = linec; s.line.width = Pt(lw)
    s.shadow.inherit = False
    s.text_frame.text = ""
    return s


def line(slide, x1, y1, x2, y2, color=RULE, w=0.75):
    from pptx.enum.shapes import MSO_CONNECTOR
    c = slide.shapes.add_connector(MSO_CONNECTOR.STRAIGHT, I(x1), I(y1), I(x2), I(y2))
    c.line.color.rgb = color; c.line.width = Pt(w)
    return c


def label(slide, x, y, w, h, text, size=7.5, color=INK3, bold=False, align=PP_ALIGN.LEFT):
    return txt(slide, x, y, w, h, text, size=size, color=color, bold=bold,
               align=align, anchor=MSO_ANCHOR.MIDDLE)


def delete_slide(prs, idx):
    xml_slides = prs.slides._sldIdLst
    slides = list(xml_slides)
    rId = slides[idx].get('{http://schemas.openxmlformats.org/officeDocument/2006/relationships}id')
    prs.part.drop_rel(rId)
    xml_slides.remove(slides[idx])


def move_slide(prs, old, new):
    xml_slides = prs.slides._sldIdLst
    slides = list(xml_slides)
    xml_slides.remove(slides[old])
    xml_slides.insert(new, slides[old])


def title_bar(slide, text, kicker=None):
    """Purple rule + title, consistent across the three content slides."""
    box(slide, 0.45, 0.42, 0.5, 0.055, fill=PURPLE, linec=None)
    y = 0.58
    if kicker:
        txt(slide, 0.45, y, 12.4, 0.24, kicker, size=10.5, color=INK3, italic=True)
        y += 0.30
    txt(slide, 0.45, y, 12.4, 0.62, text, size=25, bold=True, color=DEEP, line=0.95)
    return y + 0.72


# =============================================================== build =====
prs = Presentation(SRC)

# template ships: 0 cover | 1 instructions | 2 team | 3 problem | 4 solution | 5 video | 6 thanks
# NOTE: content slides are ADDED FIRST, then the unwanted ones deleted. Deleting
# first makes python-pptx reuse freed part names (slide6.xml etc.), which writes
# duplicate zip entries and silently drops the Video / Thank-you slides.

# The light content layout the template's own problem/solution slides use.
# prs.slide_layouts only exposes master 0, whose layouts carry a black split
# panel — search every master for the plain one.
blank = None
for m in prs.slide_masters:
    for lay in m.slide_layouts:
        if lay.name == "1_Standard slide_no bullets":
            blank = lay; break
    if blank: break
if blank is None:
    for m in prs.slide_masters:
        for lay in m.slide_layouts:
            if lay.name == "Blank":
                blank = lay; break
        if blank: break
assert blank is not None, "no plain layout found"
print("content layout:", blank.name)


def new_content_slide():
    s = prs.slides.add_slide(blank)
    for sh in list(s.shapes):
        if sh.has_text_frame:
            sh._element.getparent().remove(sh._element)
    return s


# ------------------------------------------------- SLIDE A : the problem --
s1 = new_content_slide()
y = title_bar(s1,
              "An AI response is not text to be scored.\nIt is a set of claims requesting permission to act.",
              kicker="THE PROBLEM  ·  it used to be a bad paragraph. it is now an executed transaction.")

# the transcript card
box(s1, 0.45, 2.28, 6.55, 1.62, fill=C(0x1B, 0x1D, 0x21), linec=None)
txt(s1, 0.70, 2.48, 6.05, 0.5,
    "Approved. Refund of ₹1,84,000 issued under\nclause 7.2 of the vendor agreement.",
    size=12, color=C(0xED, 0xED, 0xEA), font="Consolas", line=1.25)
txt(s1, 0.70, 3.18, 3.2, 0.5,
    "policy filter    — pass\nsafety filter   — pass\nconfidence   — 0.94",
    size=8.5, color=C(0x8B, 0x8E, 0x96), font="Consolas", line=1.3)
txt(s1, 4.05, 3.20, 2.8, 0.28, "clause 7.2 — no such clause",
    size=10, bold=True, color=C(0xE4, 0x79, 0x6E), font="Consolas")
txt(s1, 4.05, 3.52, 2.8, 0.28, "executed · Tue      found · Fri",
    size=8.5, color=C(0x8B, 0x8E, 0x96), font="Consolas")

# why every existing layer missed it
txt(s1, 7.35, 2.28, 5.5, 0.3, "WHY EVERY EXISTING LAYER MISSED IT",
    size=9, bold=True, color=PURPLE)
rows = [
    ("A second model", "gives you an opinion — same blind spots."),
    ("A filter", "checks banned words. Nothing here was banned."),
    ("A dashboard", "tells you on Friday. The money moved Tuesday."),
    ("Confidence", "is the instrument that broke. It read 0.94."),
]
ry = 2.66
for a, b in rows:
    txt(s1, 7.35, ry, 1.75, 0.26, a, size=11, bold=True, color=INK)
    txt(s1, 9.15, ry, 3.7, 0.26, b, size=11, color=INK2)
    line(s1, 7.35, ry + 0.30, 12.85, ry + 0.30, color=RULE, w=0.5)
    ry += 0.42

# the structural point
box(s1, 0.45, 4.35, 12.4, 0.9, fill=C(0xF4, 0xEE, 0xFA), linec=None)
box(s1, 0.45, 4.35, 0.045, 0.9, fill=PURPLE, linec=None)
txt(s1, 0.75, 4.52, 11.9, 0.6,
    "The evidence that could have proved it existed before the model ran — at context assembly.\n"
    "Everyone watches the exit. Nobody records the entrance.",
    size=13.5, bold=True, color=DEEP, line=1.25)

txt(s1, 0.45, 5.52, 12.4, 0.5,
    "The system didn’t fail. It was never asked to prove anything.",
    size=17, bold=True, color=INK, align=PP_ALIGN.LEFT)
txt(s1, 0.45, 6.12, 12.4, 0.3,
    "Performance, cost and responsibility are not three problems. They are three reads of one graph.",
    size=11, color=INK3, italic=True)


# ---------------------------------------------- SLIDE B : the solution ----
s2 = new_content_slide()
title_bar(s2, "Capture the evidence outside the model. Bind every claim to it.",
          kicker="PROPOSED SOLUTION  ·  STEP → SPAN → CLAIM → ACTION")

# ---- geometry ------------------------------------------------------------
SX, SW = 2.18, 2.20          # span column
CX, CW = 6.50, 2.20          # claim column
AX, AW = 10.70, 2.15         # action
ROWH, STEP0 = 0.36, 0.47
rows_y = [2.30 + i * STEP0 for i in range(6)]
BOT = rows_y[5] + ROWH        # 5.01

# --- STEP: nine ticks, four visibly unused
txt(s2, 0.50, 2.02, 1.6, 0.22, "STEP", size=10, bold=True, color=INK)
used = [1, 1, 0, 1, 0, 1, 0, 0, 1]
for i, u in enumerate(used):
    box(s2, 0.50 + i * 0.135, 3.05, 0.085, 0.80,
        fill=C(0x9E, 0x9E, 0x9E) if u else WHITE,
        linec=C(0x9E, 0x9E, 0x9E) if u else C(0xD5, 0xD5, 0xD5), lw=0.6)
txt(s2, 0.50, 3.95, 1.7, 0.2, "4 of 9 grounded nothing", size=7.5, color=INK3)

# --- context-assembly boundary (dashed, only as tall as the graph)
for k in range(11):
    yy = 2.00 + k * 0.29
    line(s2, 1.98, yy, 1.98, yy + 0.16, color=PURPLE, w=1.0)
txt(s2, 2.06, 1.76, 6.0, 0.2,
    "CONTEXT ASSEMBLY — CAPTURED HERE, OUTSIDE THE MODEL", size=7.5, bold=True, color=PURPLE)

# --- SPAN: six rendered, three legible tags, 14-counter chip
txt(s2, SX, 2.02, 2.0, 0.22, "SPAN", size=10, bold=True, color=INK)
span_tags = [("order_rows · acl:agent", False), ("fraud_note · acl:risk-only", True),
             ("vendor_agmt · acl:agent", False), (None, False), (None, False), (None, False)]
for i, (t, hot) in enumerate(span_tags):
    yy = rows_y[i]
    box(s2, SX, yy, SW, ROWH, fill=ACL_BG if hot else FILL,
        linec=ACL if hot else RULE, lw=1.5 if hot else 0.75)
    if t:
        label(s2, SX + 0.10, yy, SW - 0.2, ROWH, t, size=7.5,
              color=ACL if hot else INK2, bold=hot)
    else:
        line(s2, SX + 0.12, yy + ROWH / 2, SX + 1.05, yy + ROWH / 2,
             color=C(0xD4, 0xD4, 0xD4), w=2.2)
box(s2, SX, BOT + 0.14, 0.92, 0.24, fill=None, linec=RULE, lw=0.6)
label(s2, SX + 0.08, BOT + 0.14, 0.86, 0.24, "14 SPANS", size=7, color=INK3, bold=True)

# --- MODEL, subordinate, sitting above the gap
box(s2, 4.85, 1.90, 1.10, 0.32, fill=None, linec=C(0xDD, 0xDD, 0xDD), lw=0.6)
label(s2, 4.85, 1.90, 1.10, 0.32, "model", size=8, color=INK3, align=PP_ALIGN.CENTER)

# --- CLAIM: all six, the sixth unbound
txt(s2, CX, 2.02, 2.0, 0.22, "CLAIM", size=10, bold=True, color=INK)
claims = ["vendor id", "order date", "amount paid", "return window", "account"]
for i, t in enumerate(claims):
    yy = rows_y[i]
    box(s2, CX, yy, CW, ROWH, fill=FILL, linec=RULE)
    label(s2, CX + 0.10, yy, CW - 0.2, ROWH, t, size=7.5, color=INK2)
    line(s2, SX + SW, yy + ROWH / 2, CX, yy + ROWH / 2, color=C(0xBD, 0xBD, 0xBD), w=0.7)
yy = rows_y[5]
box(s2, CX, yy, CW, ROWH, fill=UNB_BG, linec=UNBOUND, lw=1.8)
label(s2, CX + 0.10, yy, CW - 0.2, ROWH, "clause 7.2 — no span", size=7.5,
      color=UNBOUND, bold=True)
# the sixth searches backwards and finds nothing
line(s2, CX, yy + ROWH / 2, CX - 0.85, yy + ROWH / 2, color=UNBOUND, w=1.1)
box(s2, CX - 0.98, yy + ROWH / 2 - 0.065, 0.13, 0.13, fill=None,
    linec=UNBOUND, lw=1.1, shape=MSO_SHAPE.OVAL)
txt(s2, CX, BOT + 0.16, 2.6, 0.2, "DEFAULT STATE: UNSUPPORTED", size=7, bold=True, color=INK3)

# --- CLAIM -> ACTION, severed by the unbound claim
mid = rows_y[2] + ROWH / 2
line(s2, CX + CW, mid, AX, mid, color=C(0xBD, 0xBD, 0xBD), w=1.0)
gx, gy = 9.56, mid - 0.15
line(s2, gx, gy, gx + 0.30, gy + 0.30, color=UNBOUND, w=2.6)
line(s2, gx + 0.30, gy, gx, gy + 0.30, color=UNBOUND, w=2.6)
line(s2, CX + CW, yy + ROWH / 2, gx + 0.15, gy + 0.42, color=UNBOUND, w=1.1)
box(s2, AX, mid - 0.42, AW, 0.84, fill=None, linec=INK, lw=1.8)
txt(s2, AX + 0.16, mid - 0.30, 1.9, 0.24, "ACTION", size=10, bold=True, color=INK)
txt(s2, AX + 0.16, mid + 0.00, 1.9, 0.24, "refund ₹1,84,000", size=9.5, color=INK2)

# --- the three reads: one band, each label under the column it reads
band = 5.52
for x, ttl, sub, col in ((0.50, "COST", "Unused Step", C(0x1B, 0x63, 0x50)),
                         (SX,   "RESPONSIBILITY", "Unentitled Span", ACL),
                         (CX,   "PERFORMANCE", "Unbound Claim", BLUE)):
    box(s2, x, band + 0.03, 0.055, 0.30, fill=col, linec=None)
    txt(s2, x + 0.14, band, 3.0, 0.19, ttl, size=8, bold=True, color=col)
    txt(s2, x + 0.14, band + 0.19, 3.0, 0.19, sub, size=9.5, bold=True, color=INK)

box(s2, 0.45, 6.30, 12.4, 0.62, fill=C(0xF4, 0xEE, 0xFA), linec=None)
box(s2, 0.45, 6.30, 0.045, 0.62, fill=PURPLE, linec=None)
txt(s2, 0.75, 6.44, 11.9, 0.34,
    "Three dimensions, one graph.  Evidence captured at context assembly — source · ACL · hash. "
    "Every claim starts UNSUPPORTED and must name the span that proves it.",
    size=11.5, bold=True, color=DEEP)


# ------------------------------------- SLIDE C : the decision + credibility
s3 = new_content_slide()
title_bar(s3, "The same unproven claim annotates a draft and holds a payment.",
          kicker="WHY THIS IS DIFFERENT  ·  blast radius × verdict severity")

MX, MY, MW = 0.45, 1.78, 7.45
cw0, cwn = 1.55, (MW - 1.55) / 4
hdr = ["Contradicted /\nentitlement", "Unsupported\n+ categorical",
       "Unsupported\n+ hedged", "Unknown"]
for j, h in enumerate(hdr):
    txt(s3, MX + cw0 + j * cwn, MY, cwn, 0.42, h, size=7.5, color=INK3,
        align=PP_ALIGN.CENTER, line=1.15)
line(s3, MX, MY + 0.46, MX + MW, MY + 0.46, color=C(0xAA, 0xAA, 0xAA), w=0.75)

matrix = [
    ("R3", "irreversible / regulated", [("BLOCK", M_BLOCK, M_BLOCK_T), ("ESCALATE", M_ESC, M_ESC_T),
                                        ("ESCALATE", M_ESC, M_ESC_T), ("ESCALATE", M_ESC, M_ESC_T)]),
    ("R2", "reversible write / send",  [("BLOCK", M_BLOCK, M_BLOCK_T), ("EDIT", M_EDIT, M_EDIT_T),
                                        ("EDIT", M_EDIT, M_EDIT_T), ("ESCALATE", M_ESC, M_ESC_T)]),
    ("R1", "user-visible, read-only",  [("EDIT", M_EDIT, M_EDIT_T), ("EDIT", M_EDIT, M_EDIT_T),
                                        ("PASS", M_PASS, M_PASS_T), ("PASS", M_PASS, M_PASS_T)]),
    ("R0", "internal draft",           [("PASS", M_PASS, M_PASS_T), ("PASS", M_PASS, M_PASS_T),
                                        ("PASS", M_PASS, M_PASS_T), ("PASS", M_PASS, M_PASS_T)]),
]
rh = 0.60
for i, (tier, desc, cells) in enumerate(matrix):
    yy = MY + 0.52 + i * (rh + 0.045)
    txt(s3, MX, yy + 0.06, cw0 - 0.1, 0.24, tier, size=11.5, bold=True, color=INK)
    txt(s3, MX, yy + 0.29, cw0 - 0.1, 0.22, desc, size=7.5, color=INK3)
    for j, (t, bg, fg) in enumerate(cells):
        box(s3, MX + cw0 + j * cwn, yy, cwn - 0.03, rh, fill=bg, linec=None)
        label(s3, MX + cw0 + j * cwn, yy, cwn - 0.03, rh, t, size=9, color=fg,
              bold=True, align=PP_ALIGN.CENTER)

txt(s3, MX, MY + 0.52 + 4 * (rh + 0.045) + 0.06, MW, 0.24,
    "└─ one unproven claim — four outcomes   ·   clause 7.2 → escalate · ₹1,84,000 held",
    size=8.5, bold=True, color=ACL)

txt(s3, MX, 5.28, MW, 0.62,
    "EDIT — strip or re-ground the named span, never a rewrite.    "
    "ESCALATE — inline hold; ships claim + spans + verdict.\n"
    "Bias — counterfactual flip rate, route-level, CI excludes zero.    "
    "Safety — typed interlocks: tool × args × irreversibility.\n"
    "Hard gate on actions, not tokens. Text streams with a short hold-back.",
    size=8.5, color=INK2, line=1.5)

# right column: what we refuse + the published format
RX = 8.30
txt(s3, RX, MY - 0.02, 4.55, 0.24, "WHAT WE REFUSE TO CLAIM", size=9, bold=True, color=PURPLE)
refuse = [
    ("“We eliminate hallucinations.”", "Ungrounded claims cannot authorise actions — and we report what we miss."),
    ("“Zero integration — drop it in.”", "We hook context assembly. Integration is the moat."),
    ("“Zero added latency.”", "Verification is budgeted, not free."),
    ("“99% accuracy across everything.”", "One number over three failure modes is a demo artifact."),
]
ry = MY + 0.28
for a, b in refuse:
    box(s3, RX, ry + 0.045, 0.055, 0.115, fill=UNBOUND, linec=None)
    txt(s3, RX + 0.14, ry, 4.4, 0.2, a, size=8.5, color=INK3)
    txt(s3, RX + 0.14, ry + 0.20, 4.4, 0.2, b, size=8.5, bold=True, color=INK)
    ry += 0.52

txt(s3, RX, ry + 0.04, 4.55, 0.22,
    "Everyone in this category publishes precision. This is the other number.",
    size=8.5, italic=True, color=INK2)
box(s3, RX, ry + 0.30, 4.55, 1.42, fill=C(0x19, 0x1B, 0x1F), linec=None)
txt(s3, RX + 0.16, ry + 0.42, 4.2, 0.18, "PER-ROUTE GATE REPORT — FORMAT",
    size=7, color=C(0x83, 0x86, 0x8E), font="Consolas", bold=True)
report = [
    ("route", "finance/refund-agent", False),
    ("gate latency (p50/p95)", "<measured>", False),
    ("ungrounded caught", "<measured>", False),
    ("missed  (FNR)", "<measured> ± <CI>", True),
    ("entitlement violations", "100%  (deterministic)", False),
]
rr = ry + 0.62
for k, v, hot in report:
    txt(s3, RX + 0.16, rr, 2.2, 0.17, k, size=7.5, color=C(0x83, 0x86, 0x8E), font="Consolas")
    txt(s3, RX + 2.40, rr, 1.95, 0.17, v, size=7.5, font="Consolas", bold=True,
        color=ACL if hot else C(0xED, 0xED, 0xEA))
    rr += 0.185
txt(s3, RX + 0.16, rr + 0.02, 4.2, 0.17,
    "illustrative format — Round 2 fills measured values",
    size=6.5, color=C(0x83, 0x86, 0x8E), font="Consolas", italic=True)

box(s3, 0.45, 6.42, 12.4, 0.62, fill=DEEP, linec=None)
txt(s3, 0.75, 6.52, 11.9, 0.42, "Now nothing acts until it can prove it should.",
    size=20, bold=True, color=WHITE)

# ---- now drop the template's instructions + sample content slides ---------
for idx in (4, 3, 1):          # high -> low so indices stay valid
    delete_slide(prs, idx)
# order is now: cover | team | video | thanks | A | B | C

# ---- push video + thanks to the end --------------------------------------
move_slide(prs, 2, 6)          # video  -> end
move_slide(prs, 2, 6)          # thanks -> end
# final: cover | team | A | B | C | video | thanks

want = ["Cover", "Team details", "THE PROBLEM", "PROPOSED SOLUTION",
        "WHY THIS IS DIFFERENT", "Video", "Thank you"]
got = []
for sl in prs.slides:
    first = ""
    for sh in sl.shapes:
        if sh.has_text_frame and sh.text_frame.text.strip():
            first = sh.text_frame.text.strip().split("\n")[0]; break
    got.append(first)
assert len(got) == 7, f"expected 7 slides, got {len(got)}"
for w, g in zip(want, got):
    assert w.lower() in g.lower() or w == "Cover", f"slide order wrong: expected {w!r}, got {g!r}"
print("slide order verified:", " | ".join(x[:22] for x in got))

prs.save(OUT)
print(f"wrote {OUT}  ({len(prs.slides._sldIdLst)} slides)")
for i, sl in enumerate(prs.slides):
    t = ""
    for sh in sl.shapes:
        if sh.has_text_frame and sh.text_frame.text.strip():
            t = sh.text_frame.text.strip().split("\n")[0][:58]; break
    print(f"  [{i}] {sl.slide_layout.name[:28]:30s} {t}")


# ---------------------------------------------------------------------------
# Post-process: the template's cover photo alone is 12 MB, which puts the file
# near Unstop's 20 MB cap. Recompress it and rewrite the package cleanly (the
# slide-deletion step can emit duplicate zip entries).
import zipfile, io as _io, os
from PIL import Image

def slim(path, max_px=1920, quality=82):
    src = zipfile.ZipFile(path, "r")
    names, seen = [], []
    for n in src.namelist():                      # keep the LAST write of any dup
        seen.append(n)
    names = list(dict.fromkeys(reversed(seen)))[::-1]
    before = os.path.getsize(path)
    tmp = path + ".tmp"
    with zipfile.ZipFile(tmp, "w", zipfile.ZIP_DEFLATED, compresslevel=9) as out:
        for n in names:
            data = src.read(n)
            if n.lower().endswith((".jpg", ".jpeg")) and len(data) > 400_000:
                im = Image.open(_io.BytesIO(data)).convert("RGB")
                if max(im.size) > max_px:
                    r = max_px / max(im.size)
                    im = im.resize((int(im.width * r), int(im.height * r)), Image.LANCZOS)
                buf = _io.BytesIO()
                im.save(buf, "JPEG", quality=quality, optimize=True, progressive=True)
                if buf.tell() < len(data):
                    data = buf.getvalue()
            out.writestr(n, data)
    src.close(); os.replace(tmp, path)
    after = os.path.getsize(path)
    print(f"slimmed: {before/1e6:.1f} MB -> {after/1e6:.1f} MB")

slim(OUT)
